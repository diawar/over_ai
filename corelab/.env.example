POSTGRES_DB=corelab
POSTGRES_USER=corelab
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://corelab:change-this-local-password@db:5432/corelab
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=over_admin
ADMIN_PASSWORD=replace-with-a-strong-password!
APP_ENV=local
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# JSON с серверными токенами Telegram; формат и привязка магазина: docs/MINI_APP_API.md
TELEGRAM_BOTS_JSON={}
# Separate private proxy key (32 random bytes), never prefix with VITE_.
MINI_APP_PROXY_SECRET=replace-with-a-separate-random-secret
# Shared across all sessions/providers of one organization; UTC request counts.
AI_REQUESTS_PER_MINUTE=30
AI_REQUESTS_PER_DAY=500
AI_MAX_CONCURRENT=2
